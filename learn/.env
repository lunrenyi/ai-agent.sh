# AI Agent Configuration - DeepSeek API
# Source this file before running agents: source learn/.env

# DeepSeek API Configuration (Anthropic-compatible endpoint)
export DEEPSEEK_API_KEY="$DEEPSEEK_API_KEY"
export DEEPSEEK_BASE_URL="https://api.deepseek.com/anthropic"

# Model Configuration
export MODEL_ID="deepseek-chat"

# Workspace Configuration
export WORKDIR="$(pwd)"
export MEMORY_DIR="$WORKDIR/.ai-memory"

# Usage:
#   source learn/.env
#   ./learn/v0_bash_agent.sh
#   ./learn/v1_basic_agent.sh
#   ./learn/v2_todo_agent.sh
#   ./learn/v3_subagent.sh
#   ./learn/v4_skills_agent.sh
